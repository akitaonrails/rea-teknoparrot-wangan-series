+	}
+}
+
+/// Controls from the launcher's input block (`WANGAN_INPUT_BLOCK`), written
+/// to the same places the SDL/keyboard path below writes them.
+unsafe fn handle_block_inputs(data: *mut u32, block: &mut block::Block) {
+	let c = block.read();
+
+	if c.card && !BLOCK_CARD_WAS_DOWN {
+		insert_card();
+	}
+	BLOCK_CARD_WAS_DOWN = c.card;
+
+	if c.coins != BLOCK_LAST_COINS {
+		BLOCK_LAST_COINS = c.coins;
+		BLOCK_COIN_PULSE = 10;
+	}
+
+	data.byte_add(0x24).write(0);
+
+	let mut bits = set_gear_bits(c.gear);
+	if c.test {
+		bits |= 0x20000000;
+	}
+	if c.service || BLOCK_COIN_PULSE > 0 {
+		bits |= 0x80000000;
+		BLOCK_COIN_PULSE = BLOCK_COIN_PULSE.saturating_sub(1);
+	}
+	if c.view {
+		bits |= 0x40;
+	}
+	if c.intrude {
+		bits |= 0x80;
+	}
+	if c.brake > 0.0 {
+		bits |= 0x20;
+	}
+	let gas = if c.enter && c.gas == 0.0 { 1.0 } else { c.gas };
+	if gas > 0.0 {
+		bits |= 0x10;
+	}
+	// Test menu navigation, like the GEAR_UP/GEAR_DOWN keys.
+	if c.menu_up {
+		bits |= GEAR_UP;
+	}
+	if c.menu_down {
+		bits |= GEAR_DOWN;
+	}
+	data.byte_add(0x8).write(bits);
+
+	let n2jvio = hook::get_symbol("n2jvio") as *mut u16;
+	n2jvio
+		.byte_add(0x1A8)
+		.write((i16::MAX as f32 + c.wheel * i16::MAX as f32) as u16);
+	data.byte_add(0x20).write(c.wheel.to_bits());
+	n2jvio.byte_add(0x1AA).write((gas * i16::MAX as f32) as u16);
+	data.byte_add(0x30).write(gas.to_bits());
+	n2jvio.byte_add(0x1AC).write((c.brake * i16::MAX as f32) as u16);
+	data.byte_add(0x34).write(c.brake.to_bits());
+}
+
 unsafe extern "C" fn handle_inputs(data: *mut u32) {
+	if let Some(block) = BLOCK.as_mut() {
+		return handle_block_inputs(data, block);
+	}
 	if adm::WINDOW_HANDLE.is_none() {
 		return;
 	};
