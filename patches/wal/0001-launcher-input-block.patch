+//! Cabinet controls from a launcher's 64-byte input block.
+//!
+//! When `WANGAN_INPUT_BLOCK=<path>` is set, the controls are read from that
+//! file on every poll instead of SDL/keyboard. The launcher is the only
+//! writer; we only read. Layout (little endian):
+//!
+//! ```text
+//! 0  magic  "WIO1"
+//! 4  u32    sequence
+//! 8  u8     special switches (bit 7 = Test)
+//! 9  [u8;4] player 1 switch bytes
+//! 13 [u8;4] player 2 switch bytes
+//! 17 [u16;4] coins
+//! 25 [u8;32] analog bytes, two per channel
+//! 57 u8     quit
+//! ```
+//!
+//! Player 1 byte 0: 0x40 service, 0x20 menu up, 0x10 menu down, 0x02 enter.
+//! Player 1 byte 1: 0x80/0x40/0x20/0x10 gear lever (H pattern), 0x02 view
+//! change, 0x01 intrude. Player 1 byte 2: 0x04 card insert.
+//! Analog: [0] wheel 0..255 (centre 127), [2] gas, [4] brake.
+
+use std::fs::File;
+use std::os::unix::fs::FileExt;
+
+const SIZE: usize = 64;
+const MAGIC: [u8; 4] = *b"WIO1";
+
+/// One frame of controls, already decoded.
+#[derive(Default, Clone, Copy)]
+pub struct Controls {
+	/// -1.0 full left .. 1.0 full right.
+	pub wheel: f32,
+	/// 0.0 .. 1.0.
+	pub gas: f32,
+	pub brake: f32,
+	/// 0 neutral, 1..6.
+	pub gear: u8,
+	pub view: bool,
+	pub intrude: bool,
+	pub card: bool,
+	pub test: bool,
+	pub service: bool,
+	pub menu_up: bool,
+	pub menu_down: bool,
+	pub enter: bool,
+	pub coins: u16,
+}
+
+/// The gear lever bits back to the gear number (inverse of the launcher's
+/// `gear_bits`). Anything that is not a full gate reads as neutral.
+fn gear(bits: u8) -> u8 {
+	match bits & 0xF0 {
+		0xA0 => 1,
+		0x60 => 2,
+		0x80 => 3,
+		0x40 => 4,
+		0x90 => 5,
+		0x50 => 6,
+		_ => 0,
+	}
+}
+
+fn wheel(byte: u8) -> f32 {
+	let v = byte as f32 - 127.0;
+	if v < 0.0 {
+		v / 127.0
+	} else {
+		v / 128.0
+	}
+}
+
+/// `None` until the launcher has written the block (no magic yet).
+pub fn decode(b: &[u8; SIZE]) -> Option<Controls> {
+	if b[0..4] != MAGIC {
+		return None;
+	}
+	let special = b[8];
+	let p1 = &b[9..13];
+	let coins = u16::from_le_bytes([b[17], b[18]]);
+	let analog = &b[25..57];
+	Some(Controls {
+		wheel: wheel(analog[0]),
+		gas: analog[2] as f32 / 255.0,
+		brake: analog[4] as f32 / 255.0,
+		gear: gear(p1[1]),
+		view: p1[1] & 0x02 != 0,
+		intrude: p1[1] & 0x01 != 0,
+		card: p1[2] & 0x04 != 0,
+		test: special & 0x80 != 0,
+		service: p1[0] & 0x40 != 0,
+		menu_up: p1[0] & 0x20 != 0,
+		menu_down: p1[0] & 0x10 != 0,
+		enter: p1[0] & 0x02 != 0,
+		coins,
+	})
+}
+
+pub struct Block {
+	path: String,
+	file: Option<File>,
+}
+
+impl Block {
+	/// `Some` when `WANGAN_INPUT_BLOCK` is set.
+	pub fn from_env() -> Option<Self> {
+		let path = std::env::var("WANGAN_INPUT_BLOCK").ok()?;
+		if path.is_empty() {
+			return None;
+		}
+		Some(Self { path, file: None })
+	}
+
+	/// The current controls; all released while the block cannot be read.
+	pub fn read(&mut self) -> Controls {
+		if self.file.is_none() {
+			self.file = File::open(&self.path).ok();
+		}
+		let mut buf = [0u8; SIZE];
+		match &self.file {
+			Some(file) if file.read_exact_at(&mut buf, 0).is_ok() => {
+				decode(&buf).unwrap_or_default()
+			}
+			_ => Controls::default(),
+		}
+	}
+}
