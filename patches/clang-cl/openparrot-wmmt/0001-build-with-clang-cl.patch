--- a/OpenParrot/src/Functions/Games/ES3X/WMMT6R.cpp
+++ b/OpenParrot/src/Functions/Games/ES3X/WMMT6R.cpp
@@ -111,14 +111,6 @@ static uintptr_t saveGameOffset;
 
 
 
