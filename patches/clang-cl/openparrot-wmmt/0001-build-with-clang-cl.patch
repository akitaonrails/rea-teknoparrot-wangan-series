+++ b/OpenParrot/src/Functions/Games/ES3X/WMMT6.cpp
@@ -95,14 +95,6 @@ static unsigned int WINAPI Hook_bind(SOCKET s, const sockaddr* addr, int namelen
 	}
 }
 
-static BOOL FileExists(char* szPath)
-{
-	DWORD dwAttrib = GetFileAttributesA(szPath);
-
-	return (dwAttrib != INVALID_FILE_ATTRIBUTES &&
-		!(dwAttrib & FILE_ATTRIBUTE_DIRECTORY));
-}
-
 static int ReturnTrue()
 {
 	return 1;
diff --git a/OpenParrot/src/Functions/Games/ES3X/WMMT6R.cpp b/OpenParrot/src/Functions/Games/ES3X/WMMT6R.cpp
