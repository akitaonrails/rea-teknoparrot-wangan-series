+static void SeedDefaultSettings() {
+	for (const char* path : { ".\\Fsetting.lua.gz", ".\\Gsetting.lua.gz" }) {
+		if (GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES)
+			continue;
+		FILE* f = fopen(path, "wb");
+		if (f) {
+			fwrite(wmmt6rrDefaultSetting, 1, sizeof(wmmt6rrDefaultSetting), f);
+			fclose(f);
+		}
+	}
+}
+
+// Drive cabinet without a Wangan terminal: the boot TERMINAL LINK check
+// (InfoSystem state handler at +0x744547: "status[17] = 1 (checking); jmp
+// end") waits forever. Same fix as OpenParrot's WMMT6R module (+0x718FA1):
+// retarget that jmp to the block that marks the link as checked
+// (+0x744627: "status[17] = 2"). Applied only if the bytes match 3.05.03.
+static void SkipTerminalLinkWait(uintptr_t base) {
+	static const unsigned char expected[] = { 0xC7, 0x86, 0xF0, 0x07, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0xE9, 0xEF, 0x0B, 0x00, 0x00 };
+	if (memcmp((void*)(base + 0x744547), expected, sizeof(expected)) == 0)
+		injector::WriteMemory<DWORD>(base + 0x744552, 0x744627 - 0x744556, true);
+}
